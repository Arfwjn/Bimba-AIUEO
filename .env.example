# Application Environment Configuration
APP_NAME="biMBA AIUEO Unit Kebanggan"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Database Configuration
# Driver option: 'mysql' (for phpMyAdmin/cPanel) or 'sqlite'
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bimba_aiueo
DB_USER=root
DB_PASS=

# AES 256 Encryption Secret Key (32 characters)
AES_KEY=biMBA_AIUEO_SecretKey_2026_AES256
AES_METHOD=AES-256-CBC
